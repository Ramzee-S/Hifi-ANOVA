# Byte-compiled / optimized / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
.conda/

# Generated experiment / figure output
figures/
figures_*/
plots/
*_results/
benchmark_results/
overnight_results*/
study_results/
revision_results/
*.png
*.pdf

# Model checkpoints / saved artifacts
*.pkl
*.npz
saved_models/
my_model/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log

# Working notes / scratch dumps (Claude Code transcripts, analysis dumps, etc.)
CC_*

# Manuscript / paper sources — this is a code-only release; the write-up is
# kept out deliberately (may be added later, use `git add -f` if so).
*.tex
*.bib
*.aux
*.bbl
*.blg
*.out
*.synctex.gz

# Exception: committed documentation figures (override figures/ and *.png above)
!docs/figures/
!docs/figures/*.png

# Exception: this is a SOURCE package, not generated plot output — the bare
# `plots/` rule above (for figure-output dirs) must not swallow it.
!hifi_anova/analysis/plots/
!hifi_anova/analysis/plots/**
hifi_anova/analysis/plots/**/__pycache__/
hifi_anova/analysis/plots/**/*.py[cod]

# Exception: dev/ is private-but-committed (export-ignored from releases, see
# .gitattributes). Everything inside is trackable — session notes, scratch
# .tex/.pdf, dev-only tests/examples — except caches and logs.
!dev/**
dev/**/__pycache__/
dev/**/*.py[cod]
dev/**/*.log
